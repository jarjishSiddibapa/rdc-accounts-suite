# MySQL (the database is created automatically when this account has permission)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=rdc_accounts_suite

# Required only when the users table is empty. Remove the password after the
# first successful startup; later users are managed from the admin panel.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password

# Set this to the LAN URL users open so password-reset links point to the
# correct server. Example: http://192.168.1.50:8000
APP_BASE_URL=

# Use true only when the suite is served over HTTPS.
SESSION_COOKIE_SECURE=false
ENABLE_API_DOCS=false

# Optional global overrides. Leave unset to use safe role-specific defaults:
# API 3+2, each processing worker 2+1, scheduler/initializer 1+1.
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=30
MAX_UPLOAD_BYTES=629145600

# Multi-process runtime defaults for the documented 4-core / 8-GB server.
API_WORKERS=2
JOB_WORKER_PROCESSES=2
JOB_POLL_SECONDS=0.75
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=15
JOB_MAX_ATTEMPTS=2

# Global number of GST enrichment jobs allowed to use Oracle simultaneously.
# Each GST job has its own internal Oracle connection pool, so increase only
# after confirming the database connection allowance with the Oracle DBA.
ORACLE_GST_JOB_CONCURRENCY=1

# Oracle ERP connection, used only by the Unapplied Receipts tool to look up
# Location/Comments live for the receipts in the uploaded file.
# ORACLE_INSTANT_CLIENT_DIR defaults to the instantclient/ folder already
# vendored in this repo, so it can usually be left unset.
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_INSTANT_CLIENT_DIR=

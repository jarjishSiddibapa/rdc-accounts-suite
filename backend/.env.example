# MySQL (the database is created automatically when this account has permission)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=rdc_accounts_suite

# Required only when the users table is empty. Remove the password after the
# first successful startup; later users are managed from the admin panel.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password

# Set this to the LAN URL users open so password-reset links point to the
# correct server. Example: http://192.168.1.50:8000
# Left empty, the link uses the address the request came to, but only when that is
# this server's own name or address (a forged Host header would otherwise send the
# reset token to someone else's server); with any other Host no reset mail is sent
# and a warning is logged.
APP_BASE_URL=

# Use true only when the suite is served over HTTPS.
SESSION_COOKIE_SECURE=false
ENABLE_API_DOCS=false

# Optional global overrides. Leave unset to use safe role-specific defaults:
# API 3+2, each processing worker 2+1, scheduler/initializer 1+1.
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=30
MAX_UPLOAD_BYTES=629145600

# Multi-process runtime. How many web workers, processing workers and Excel helpers to run is worked out from the
# server's CPU cores and free memory each time the suite starts. Leave these out (or write auto) to let it decide;
# set a number only to fix it by hand.
# API_WORKERS=auto
# JOB_WORKER_PROCESSES=auto
# CPU_JOB_POOL_WORKERS=auto
JOB_POLL_SECONDS=0.75
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=15
JOB_MAX_ATTEMPTS=2
# Workers check explicit tab-close cancellation every two seconds. If a browser
# crashes before it can notify the API, lack of status polling expires the job
# after 120 seconds and releases its server/Oracle resources.
JOB_CLIENT_MONITOR_SECONDS=2
JOB_CLIENT_HEARTBEAT_TIMEOUT_SECONDS=120

# Global number of ERP report jobs (GST, Debtors, Sales Register, Unidentified Entries) allowed to use Oracle
# simultaneously; the default is 2. Each job has its own internal Oracle connection pool (several connections),
# so raise it only after confirming the database connection allowance with the Oracle DBA.
# ORACLE_GST_JOB_CONCURRENCY=2

# The open-ageing query (Untagged Invoices, Unapplied Receipts, GST adder) is
# split into this many slices that run at once, each on its own Oracle
# connection (about 20 s -> 8 s with 4). 1 runs it as a single query.
# ORACLE_FETCH_PARALLELISM=4

# Parallel degree the database is asked to use (an optimizer hint) for the
# Unapplied Receipts Register query: about 21 s -> 5 s with 4. 0 leaves the hint out.
# ORACLE_REGISTER_PARALLEL_DEGREE=4

# Oracle ERP connection, used only by the Unapplied Receipts tool to look up
# Location/Comments live for the receipts in the uploaded file.
# ORACLE_INSTANT_CLIENT_DIR defaults to the instantclient/ folder already
# vendored in this repo, so it can usually be left unset.
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_INSTANT_CLIENT_DIR=

# The fast row writer for the GST, Untagged Invoices and Sales Register workbooks. It checks itself and
# falls back automatically; 0 switches it off and uses the plain xlsxwriter path.
# FAST_XLSX=1

# A queued job waits to start while the server has less than this much free memory (other programs share it), but
# never longer than JOB_MEMORY_WAIT_MAX_SECONDS. The page shows "Waiting for server memory". 0 switches it off.
# JOB_MIN_FREE_MEMORY_MB=1024
# JOB_MEMORY_WAIT_MAX_SECONDS=600
